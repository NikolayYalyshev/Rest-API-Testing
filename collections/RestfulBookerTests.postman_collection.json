							"let perfStatus = actualTime <= responseTimeLimit ",
							"    ? `✅ Быстрый ответ: ${actualTime}мс` ",
							"    : `⚠️ Задержка: ${actualTime}мс (превышение на ${actualTime - responseTimeLimit}мс)`;",
							"",
							"// 3. Запускаем тест с динамическим названием",
							"pm.test(`⚡ Производительность: ${perfStatus}`, function () {",
							"    if (actualTime > responseTimeLimit) {",
							"        // Если время превышено, тест проходит, но выводит предупреждение в лог",
							"        // Либо можно уронить тест через pm.expect.fail(), если это критично",
							"        console.warn(`[Performance Alert]: Сервер отвечает медленнее ${responseTimeLimit}мс`);",
							"    }",
							"    ",
							"    pm.expect(actualTime, `Время ответа ${actualTime}мс выше нормы в ${responseTimeLimit}мс`)",
							"      .to.be.below(responseTimeLimit + 1); // +1 для корректного сравнения порогов",
							"});",
							""
