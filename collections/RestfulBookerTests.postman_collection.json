				{
					"name": "FilterByCheckin\\out",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Проверяем что прислал сервер ",
									"let jsonData;",
									"try {",
									"    jsonData = pm.response.json();",
									"} catch (e) {",
									"    jsonData = null; // возможно ошибка 500",
									"}",
									"",
									"const isNotEmpty = jsonData && Array.isArray(jsonData) && jsonData.length > 0;",
									"",
									"const rawCheckin = pm.request.url.query.get(\"checkin\");",
									"const rawCheckout = pm.request.url.query.get(\"checkout\");",
									"",
									"// Динамический текст теста относительно наличия данных в ответе",
									"let testName = isNotEmpty ",
									"    ? `✅ Найдено ${jsonData.length} объектов (${rawCheckin} — ${rawCheckout})`",
									"    : `❌ Данные не найдены или ошибка сервера`;",
									"",
									"// Основной тест со сложной логикой фильтрации дат",
									"pm.test(testName, function () {",
									"    // Если jsonData пустой (из-за 500 ошибки)",
									"    pm.expect(jsonData, \"Сервер не вернул валидный JSON. Проверьте формат дат (нужен YYYY-MM-DD)\").to.not.be.null;",
									"    ",
									"    if (isNotEmpty) {",
									"        pm.expect(jsonData[0]).to.have.property(\"bookingid\");",
									"    } else {",
									"        pm.expect.fail(\"Массив пуст или параметры запроса неверны\");",
									"    }",
									"});",
									"",
									"if (!rawCheckin || !rawCheckout) {",
									"    pm.test(\"❌ Ошибка: Проверьте вкладку Params (checkin/checkout)\", function () {",
									"        pm.expect.fail(\"Один из параметров даты пуст или не найден\");",
									"    });",
									"} else if (isNotEmpty) {",
									"    ",
									"    const firstId = jsonData[0].bookingid; ",
									"    const url = `https://restful-booker.herokuapp.com/booking/${firstId}`;",
									"",
									"    pm.sendRequest(url, function (err, res) {",
									"        if (err || res.code !== 200) return;",
									"",
									"        const details = res.json();",
									"        ",
									"        // Переводим в объекты дат для сравнения",
									"        const dActualCheckin = new Date(details.bookingdates.checkin);",
									"        const dActualCheckout = new Date(details.bookingdates.checkout);",
									"        const dExpectedCheckin = new Date(rawCheckin);",
									"        const dExpectedCheckout = new Date(rawCheckout);",
									"",
									"        pm.test(`Проверка ID ${firstId}: даты входят в диапазон`, function () {",
									"            // Проверяем, что даты корректные ",
									"            pm.expect(dActualCheckin.toString(), \"Дата заезда в БД некорректна\").to.not.equal(\"Invalid Date\");",
									"            pm.expect(dExpectedCheckout.toString(), \"Дата checkout в параметрах некорректна\").to.not.equal(\"Invalid Date\");",
									"",
									"            // Сравнение даты заезда ",
									"            pm.expect(dActualCheckin, `Заезд в базе (${details.bookingdates.checkin}) должен быть не раньше ${rawCheckin}`)",
									"                .to.be.at.least(dExpectedCheckin);",
									"            ",
									"            // Сравнение даты выезда ",
									"            pm.expect(dActualCheckout, `Выезд в базе (${details.bookingdates.checkout}) должен быть не позже ${rawCheckout}`)",
									"                .to.be.at.most(dExpectedCheckout);",
									"        });",
									"    });",
									"} else {",
									"    // Если ни одно из условий не сработало",
									"    console.log(\"Массив пуст, детальная проверка ID пропущена.\"); ",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
