		{
			"name": "CreateBooking",
			"item": [
				{
					"name": "CreateBooking",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"",
									"const xml2js = require('xml2js'); ",
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"    const requestContentType = pm.request.headers.get(\"Content-Type\") || \"\";",
									"    ",
									"    const formatLabel = requestContentType.includes(\"xml\") ? \"XML\" : \"JSON\";",
									"// Тест проверки совпадения данных в запросе и ответе",
									"    pm.test(`✅ Данные в ответе совпадают с отправленными в формате ${formatLabel}`, function () {",
									"        if (formatLabel === \"XML\") {",
									"            xml2js.parseString(pm.request.body.raw, (err, result) => {",
									"                if (err) { pm.expect.fail(\"Ошибка чтения XML из запроса: \" + err); }",
									"                ",
									"                const b = result.booking;",
									"                pm.expect(jsonData.booking.firstname).to.equal(b.firstname[0]);",
									"                pm.expect(jsonData.booking.lastname).to.equal(b.lastname[0]);",
									"                pm.expect(jsonData.booking.totalprice.toString()).to.equal(b.totalprice[0]);",
									"                pm.expect(jsonData.booking.depositpaid.toString()).to.equal(b.depositpaid[0]);",
									"                pm.expect(jsonData.booking.bookingdates.checkin).to.equal(b.bookingdates[0].checkin[0]);",
									"                pm.expect(jsonData.booking.bookingdates.checkout).to.equal(b.bookingdates[0].checkout[0]);",
									"            });",
									"        } else {",
									"            const sentData = JSON.parse(pm.request.body.raw);",
									"            ",
									"            pm.expect(jsonData.booking.firstname).to.equal(sentData.firstname);",
									"            pm.expect(jsonData.booking.lastname).to.equal(sentData.lastname);",
									"            pm.expect(jsonData.booking.totalprice).to.equal(sentData.totalprice);",
									"            pm.expect(jsonData.booking.depositpaid).to.equal(sentData.depositpaid);",
									"            pm.expect(jsonData.booking.bookingdates.checkin).to.equal(sentData.bookingdates.checkin);",
									"            pm.expect(jsonData.booking.bookingdates.checkout).to.equal(sentData.bookingdates.checkout);",
									"        }",
									"    });",
									"",
									"// Сохраняем ID для цепочки тестов",
									"if (jsonData.bookingid) {",
									"    pm.collectionVariables.set(\"last_booking_id\", jsonData.bookingid);",
									"    console.log(\"Сохранен ID созданного бронирования:\", jsonData.bookingid);",
									"}",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"protocolProfileBehavior": {
						"disabledSystemHeaders": {
							"content-type": true,
							"accept": true
						}
					},
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "text/xml"
							},
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "<booking>\n    <firstname>Jim</firstname>\n    <lastname>Brown</lastname>\n    <totalprice>112</totalprice>\n    <depositpaid>true</depositpaid>\n    <bookingdates>\n      <checkin>2018-01-01</checkin>\n      <checkout>2019-01-01</checkout>\n    </bookingdates>\n    <additionalneeds>Breakfast</additionalneeds>\n  </booking>",
							"options": {
								"raw": {
									"language": "xml"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/{{booking_path}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"{{booking_path}}"
							]
						}
					},
					"response": []
				}
			],
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"packages": {},
						"requests": {},
						"exec": [
							""
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"packages": {},
						"requests": {},
						"exec": [
							"",
							"const xml2js = require('xml2js'); ",
							"",
							"const postSchema = {",
							"    \"type\": \"object\",",
							"    \"required\": [\"bookingid\", \"booking\"],",
							"    \"properties\": {",
							"        \"bookingid\": { \"type\": \"number\" },",
							"        \"booking\": {",
							"            \"type\": \"object\",",
							"            \"required\": [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\"],",
							"            \"properties\": {",
							"                \"firstname\": { \"type\": \"string\" },",
							"                \"lastname\": { \"type\": \"string\" },",
							"                \"totalprice\": { \"type\": \"number\" },",
							"                \"depositpaid\": { \"type\": \"boolean\" },",
							"                \"bookingdates\": {",
							"                    \"type\": \"object\",",
							"                    \"required\": [\"checkin\", \"checkout\"]",
							"                },",
							"                \"additionalneeds\": { \"type\": \"string\" }",
							"            }",
							"        }",
							"    }",
							"};",
							"",
							"// Подготовка данных",
							"const requestContentType = pm.request.headers.get(\"Content-Type\") || \"\";",
							"const responseContentType = pm.response.headers.get(\"Content-Type\") || \"\";",
							"const statusCode = pm.response.code;",
							"",
							"//Определение форматов",
							"const isXmlReq = requestContentType.includes(\"xml\");",
							"const isJsonReq = requestContentType.includes(\"json\");",
							"let requestLabel = isXmlReq ? \"XML\" : (isJsonReq ? \"JSON\" : \"Неизвестно\");",
							"// Информационный тест, какие данные мы отправили",
							"pm.test(`📤 Структура запроса: ${requestLabel}`, function () {",
							"    pm.expect(isXmlReq || isJsonReq, \"Запрос должен быть JSON или XML\").to.be.true;",
							"});",
							"",
							"// Тест проверки ответа",
							"if (statusCode === 200) {",
							"    // Проверка JSON-ответа",
							"    if (responseContentType.includes(\"application/json\")) {",
							"        pm.test(\"✅ Структура ответа соответствует JSON-схеме\", function () {",
							"            pm.response.to.have.jsonSchema(postSchema);",
							"        });",
							"    } ",
							"    // Проверка XML-ответа",
							"    else if (responseContentType.includes(\"xml\")) {",
							"        pm.test(\"✅ Структура ответа соответствует XML-схеме\", function () {",
							"            xml2js.parseString(pm.response.text(), (err, result) => {",
							"                if (err) { pm.expect.fail(\"Ошибка парсинга XML: \" + err); }",
							"",
							"                pm.expect(result).to.have.property(\"booking\");",
							"                const b = result.booking;",
							"                ",
							"                pm.expect(b).to.have.property(\"bookingid\");",
							"                pm.expect(b).to.have.property(\"booking\");",
							"                ",
							"                // ВАЖНО: xml2js создает массивы, берем индекс [0]",
							"                const details = b.booking[0];",
							"                pm.expect(details).to.have.all.keys(",
							"                    \"firstname\", \"lastname\", \"totalprice\", ",
							"                    \"depositpaid\", \"bookingdates\", \"additionalneeds\"",
							"                );",
							"            });",
							"        });",
