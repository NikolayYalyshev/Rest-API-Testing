							"const isJsonReq = requestContentType.includes(\"json\");",
							"let requestLabel = isXmlReq ? \"XML\" : (isJsonReq ? \"JSON\" : \"Неизвестно\");",
							"",
							"pm.test(`📤 Структура запроса: ${requestLabel}`, function () {",
							"    pm.expect(isXmlReq || isJsonReq, \"Запрос должен быть JSON или XML\").to.be.true;",
							"});",
							"",
							"// Тест проверки ответа",
							"if (statusCode === 200) {",
							"    // Проверка JSON-ответа",
							"    if (responseContentType.includes(\"application/json\")) {",
							"        pm.test(\"✅ [PATCH] Структура ответа соответствует JSON-схеме\", function () {",
							"            pm.response.to.have.jsonSchema(patchSchema);",
							"        });",
							"    } ",
							"    // Проверка XML-ответа",
							"    else if (responseContentType.includes(\"xml\")) {",
							"        pm.test(\"✅ [PATCH] Структура ответа соответствует XML-схеме\", function () {",
							"            const { XMLParser } = require('fast-xml-parser');",
							"            const parser = new XMLParser();",
							"            const jsonObj = parser.parse(pm.response.text());",
							"            const details = jsonObj.booking || jsonObj;",
							"",
							"            pm.expect(details, \"Объект бронирования не найден\").to.exist;",
							"            pm.expect(details).to.have.any.keys(\"firstname\", \"lastname\");",
							"        });",
							"    }",
							"    // Обработка HTML (если ошибки в обработке сервера)",
							"    else if (responseContentType.includes(\"html\")) {",
							"        pm.test(\"⚠️ [PATCH] Данные обновлены (но ответ в формате HTML)\", function () {",
							"            const body = pm.response.text().toLowerCase();",
							"            pm.expect(body).to.not.include(\"forbidden\");",
							"            pm.expect(body).to.not.include(\"internal server error\");",
							"        });",
							"    }",
							"} ",
							"// Обработка ошибок",
							"else {",
							"    let errorMessage = `❌ Ошибка сервера: ${statusCode} (${pm.response.status})`;",
							"    pm.test(errorMessage, function () {",
							"        let detail = \"Данные не получены. \";",
							"        if (statusCode === 405) detail += \"🚫 Method Not Allowed: Проверьте метод (PATCH).\";",
							"        if (statusCode === 403) detail += \"🔐 Forbidden: Обновите токен в Cookie.\";",
							"        if (statusCode === 404) detail += \"🔍 Объект не найден.\";",
							"        pm.expect.fail(`${detail} Тело: ${pm.response.text()}`);",
							"    });",
							"}",
							"",
							"",
							"const cookieHeader = pm.request.headers.get(\"Cookie\");",
							"const authHeader = pm.request.headers.get(\"Authorization\");",
							"",
							"let foundInfo = [];",
							"if (cookieHeader) foundInfo.push(\"Cookie ✅\");",
							"if (authHeader) foundInfo.push(\"Authorization ✅\");",
							"",
							"// Формируем название теста динамически",
							"let testName = \"🛡️ Проверка безопасности: \";",
							"if (foundInfo.length > 0) {",
							"    testName += `Заголовок авторизации корректен (${foundInfo.join(\" и \")})`;",
							"} else {",
							"    testName += \"Заголовки авторизации ОТСУТСТВУЮТ\";",
							"}",
							"",
							"// Тест проверки, что заголовок авторизации использовался в запросе",
							"pm.test(testName, function () {",
							"    const isPresent = (cookieHeader !== undefined && cookieHeader !== \"\") || ",
							"                      (authHeader !== undefined && authHeader !== \"\");",
							"",
							"    if (!isPresent) {",
							"        const errorDetail = \"Запрос отправлен без Cookie или Authorization. \" + ",
							"                            \"Согласно требованиям безопасности, сервер ДОЛЖЕН вернуть 403 Forbidden.\";",
							"        pm.expect.fail(errorDetail);",
							"    } else {",
							"        // Если заголовок есть, тест просто проходит (Passed)",
							"        pm.expect(true).to.be.true;",
							"    }",
							"});",
							""
						]
					}
				}
			]
